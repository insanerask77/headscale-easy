# Headscale Easy 2.0: optional answers, so the setup wizard has less to ask.
# `docker compose up -d` works without this file. To use it: cp .env.example .env && chmod 600 .env
# Every variable the image reads is in docs/configuration.md.

# --- Address and HTTPS --------------------------------------------------------------------------
# The address people and devices use to reach this server. With https:// and HSE_TLS=auto the
# server gets a Let's Encrypt certificate (DNS must point here; ports 80 and 443 reachable from
# the Internet). Leave it commented to set it in the wizard.
#HSE_PUBLIC_URL=https://vpn.example.com

# auto      Let's Encrypt (needs ACME_EMAIL)
# internal  a certificate of Caddy's own CA, for a LAN (install the CA on every client)
# off       plain HTTP: for a trusted network, or behind a proxy you already run (docs/advanced.md)
#HSE_TLS=auto
#ACME_EMAIL=admin@example.com

# --- First administrator ------------------------------------------------------------------------
# Leave both commented to create the administrator in the wizard (the one-time token is in
# `docker compose logs`). Set both to skip the wizard and start with that account.
#HSE_ADMIN_EMAIL=
#HSE_ADMIN_PASSWORD=

# --- General ------------------------------------------------------------------------------------
# Time zone, used by the backup schedule and the logs.
#TZ=UTC

# Image version. The compose file pins 2.0.0; to update, change it and run
# `docker compose pull && docker compose up -d`.
#HSE_VERSION=2.0.0

# Host ports. Change them when 80/443 are taken; keep the port in HSE_PUBLIC_URL in step.
#HSE_HTTP_PORT=80
#HSE_HTTPS_PORT=443
# UDP port of the DERP/STUN relay. It is the same inside and outside the container (clients are told
# this port), so change it here, not in compose.yaml. Open it in the firewall.
#HSE_DERP_PORT=3478

# --- Backups ------------------------------------------------------------------------------------
# Nightly at 03:00 (cron syntax, in TZ), 14 days kept. BACKUP_SCHEDULE=off disables them.
#BACKUP_SCHEDULE=0 3 * * *
#BACKUP_KEEP_DAYS=14
