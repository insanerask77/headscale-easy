# =============================================================================
# Headscale Easy — configuration reference
# https://github.com/insanerask77/headscale-easy
# =============================================================================
# You normally do NOT write this file by hand: ./install.sh asks a few
# questions and writes .env for you (and keeps it on later runs). This file
# documents every setting. See docs/configuration.md for details.
# NEVER commit your real .env: it holds secrets.

# Installer and web UI default language: en | es
UI_LANG=en

# --- Network and access ------------------------------------------------------
# One domain. Caddy routes it:
#   /           -> Headscale (control plane)
#   /admin      -> Headscale Easy web UI
#   /authentik  -> Authentik (only with AUTH_PROVIDER=authentik)
DOMAIN=vpn.example.com
URL_SCHEME=https
# What clients use with --login-server (no port unless Caddy uses a
# non-standard one)
SERVER_URL=https://vpn.example.com
HEADSCALE_PUBLIC_URL=https://vpn.example.com

# Who provides HTTPS:
#   letsencrypt  Caddy gets a Let's Encrypt certificate (public DNS + 80/443)
#   selfsigned   Caddy's internal CA (install caddy-root-ca.crt on clients)
#   front        another proxy in front (NPM, nginx, Traefik, Caddy); the
#                installer writes its snippet to reverse-proxy/
#   none         plain HTTP (localhost, trusted LAN, or behind another VPN)
SSL_MODE=letsencrypt
ACME_EMAIL=admin@example.com

# With SSL_MODE=front: npm | nginx | traefik | caddy, this machine's address as
# seen from that proxy, and optionally the proxy's LAN IP (so containers reach
# the public URL without NAT loopback)
FRONT_PROXY=
BACKEND_HOST=
FRONT_PROXY_IP=

# --- Ports ---------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
# Internal (not published)
HEADSCALE_GRPC_PORT=50443
HEADSCALE_HTTP_PORT=8080
HEADSCALE_METRICS_PORT=9090
# DERP/STUN, UDP: must be reachable from the Internet
HEADSCALE_DERP_PORT=3478

# --- Tailnet ---------------------------------------------------------------------
TAILNET_NAME=myorg
ADMIN_USER=admin
IP_PREFIXES_V4=100.64.0.0/10
IP_PREFIXES_V6=fd7a:115c:a1e0::/48
LOG_LEVEL=info
# Each user only reaches their own devices (ACL autogroup:self). Only applied
# when Headscale has no policy yet.
NETWORK_ISOLATION=true
# Key expiry of new devices on first install (then managed in the web UI:
# Settings → General). 0 = never
NODE_KEY_EXPIRY=180d

# Headscale API key used by the web UI; created by the installer
APIKEY_EXPIRATION=90d
HEADSCALE_API_KEY=

# --- Sign-in ---------------------------------------------------------------------
#   authentik  built-in Authentik: passwords + optional Google
#   external   your own OIDC provider (Keycloak, Authelia, Google...)
#   none       admins sign in with a Headscale API key
AUTH_PROVIDER=authentik
# 'authentik' starts the Authentik containers with a plain `docker compose up`
COMPOSE_PROFILES=authentik
ENABLE_OIDC=true
OIDC_ISSUER_URL="https://vpn.example.com/authentik/application/o/headscale/"
OIDC_CLIENT_ID="headscale"
OIDC_CLIENT_SECRET=""
OIDC_SCOPE="openid profile email"
OIDC_EMAIL_CLAIM="email"

# --- Web UI ----------------------------------------------------------------------
# Signs session cookies (openssl rand -hex 32)
PORTAL_SESSION_SECRET=
PORTAL_OIDC_ISSUER="https://vpn.example.com/authentik/application/o/headscale-easy/"
PORTAL_OIDC_CLIENT_ID="headscale-easy"
PORTAL_OIDC_CLIENT_SECRET=""
# Also accept the Headscale API key to sign in as admin (emergency access)
PORTAL_API_KEY_LOGIN=false
# Admins: members of these groups or owners of these emails
PORTAL_ADMIN_GROUPS="vpn-admins,authentik Admins"
PORTAL_ADMIN_EMAILS=""
# Rename machines that register as "localhost" (Tailscale apps for iPhone,
# iPad, Apple TV and the App Store build for Mac) to <owner>-<device>
AUTO_RENAME_LOCALHOST=true
# uid/gid of the project files' owner, and the Docker socket's gid
PORTAL_UID=1000
PORTAL_GID=1000
DOCKER_GID=999

# --- Authentik (AUTH_PROVIDER=authentik) -----------------------------------------
# Never change these two after the first start
AUTHENTIK_SECRET_KEY=
AUTHENTIK_PG_PASS=
# Only read on Authentik's first start
AUTHENTIK_ADMIN_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_PASSWORD=
# Two-factor authentication (authenticator app or passkey):
#   admins    required for vpn-admins / authentik Admins (default)
#   everyone  required for every user
#   optional  each user decides
MFA_REQUIRED=admins
# Sign in with Google (empty = off). Redirect URI to register at Google:
#   https://vpn.example.com/authentik/source/oauth/callback/google/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Backups -----------------------------------------------------------------------
# Daily backup of Headscale (database and keys), Authentik's database, the
# configuration and Caddy's CA. Cron syntax; "off" disables the schedule.
BACKUP_SCHEDULE="0 3 * * *"
# Where (a path on this host, e.g. a NAS mount) and for how many days
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# --- Advanced ----------------------------------------------------------------------
TZ=UTC
NETWORK_NAME=headscale-net
# Headscale Easy image tag (ghcr.io/insanerask77/headscale-easy)
HSE_VERSION=latest
HEADSCALE_IMAGE_TAG=latest
CADDY_IMAGE_TAG=2-alpine
AUTHENTIK_IMAGE_TAG=2026.8.3
