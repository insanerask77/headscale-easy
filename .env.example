# =============================================================================
# CONFIGURACIÓN HEADSCALE + MI VPN
# =============================================================================
# Este archivo muestra todas las variables de configuración disponibles.
# El instalador install.sh generará un .env con valores personalizados.

# -----------------------------------------------------------------------------
# RED Y ACCESO
# -----------------------------------------------------------------------------
# Hay UN solo modo de despliegue: Caddy delante de Headscale y del panel,
# enrutando un único dominio.
#
#   /          -> Headscale (control plane)
#   /mi-vpn    -> panel Mi VPN (/admin redirige aquí)
#   /authentik -> Authentik (sólo con AUTH_PROVIDER=authentik)
#
# Lo único que cambia es quién pone el HTTPS, y eso lo decide SSL_MODE.

# Dominio o IP con el que se accede al stack (sin esquema ni puerto)
# Ejemplos: vpn.midominio.com, 192.168.1.100, localhost
DOMAIN=vpn.example.com

# Esquema de las URLs públicas (http o https). Lo deriva el instalador de
# SSL_MODE: https salvo con SSL_MODE=none.
URL_SCHEME=https

# URL del control plane: la que usan los clientes con --login-server.
# No lleva puerto salvo que Caddy escuche en uno no estándar.
SERVER_URL=https://vpn.example.com
HEADSCALE_PUBLIC_URL=https://vpn.example.com

# Quién pone el HTTPS. Caddy arranca y enruta en los cuatro casos.
# - letsencrypt: Caddy pide el certificado a Let's Encrypt. Requiere un dominio
#                con DNS público apuntando aquí y los puertos 80/443 abiertos.
# - selfsigned:  Caddy firma con su CA interna. Hay que instalar esa CA en cada
#                cliente Tailscale o no conectarán.
# - front:       lo pone otro proxy por delante (NPM, nginx, Traefik u otro
#                Caddy). Aquí Caddy sirve HTTP y el instalador deja el snippet
#                de ese proxy en reverse-proxy/.
# - none:        sin HTTPS en ninguna capa. Sólo localhost, LAN de confianza o
#                un acceso que ya viaje por otra VPN.
SSL_MODE=letsencrypt

# Email para Let's Encrypt (solo si SSL_MODE=letsencrypt)
ACME_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# PROXY POR DELANTE (solo si SSL_MODE=front)
# -----------------------------------------------------------------------------

# Qué proxy tienes delante: npm, nginx, traefik o caddy.
# Determina qué snippet genera el instalador en reverse-proxy/.
FRONT_PROXY=

# Dirección de ESTA máquina tal como la ve el proxy: es el destino al que
# reenvía. Se usa para generar el snippet.
BACKEND_HOST=

# -----------------------------------------------------------------------------
# PUERTOS
# -----------------------------------------------------------------------------

# Puerto HTTP de Caddy. Con certificado propio sólo sirve para el reto ACME y
# la redirección a HTTPS; con SSL_MODE=front o none es el único que se publica
# (y, con front, es donde el proxy de delante encuentra a Caddy).
HTTP_PORT=80

# Puerto HTTPS de Caddy. Sólo se publica si Caddy tiene el certificado
# (SSL_MODE=letsencrypt o selfsigned); si no, nadie escucharía ahí.
HTTPS_PORT=443

# Puerto gRPC de Headscale (interno, no necesita exponerse externamente)
HEADSCALE_GRPC_PORT=50443

# Puerto HTTP API de Headscale. Interno: sólo lo alcanza Caddy.
HEADSCALE_HTTP_PORT=8080

# Puerto DERP/STUN de Headscale (UDP, debe ser accesible externamente).
# NINGÚN reverse proxy HTTP puede transportarlo: ábrelo directo contra esta
# máquina, o desactiva derp.server.enabled y usa los relays de Tailscale.
HEADSCALE_DERP_PORT=3478

# Puerto Metrics de Headscale (interno, opcional)
HEADSCALE_METRICS_PORT=9090

# -----------------------------------------------------------------------------
# HEADSCALE - CONFIGURACIÓN DE LA RED TAILNET
# -----------------------------------------------------------------------------

# Nombre de la organización/tailnet (alfanumérico, sin espacios)
TAILNET_NAME=myorg

# Usuario administrador creado automáticamente durante el despliegue
ADMIN_USER=admin

# Caducidad de la API key generada automáticamente (ej: 90d, 365d)
APIKEY_EXPIRATION=90d

# API key de Headscale. La genera install.sh tras arrancar Headscale. La usa el
# panel para hablar con Headscale y sirve para entrar en él como admin (sin
# OIDC, o con PORTAL_API_KEY_LOGIN=true).
# NUNCA la rellenes aquí a mano ni la subas al repositorio.
HEADSCALE_API_KEY=

# Dirección de red IPv4 para los clientes (CIDR)
IP_PREFIXES_V4=100.64.0.0/10

# Dirección de red IPv6 para los clientes (CIDR, opcional)
IP_PREFIXES_V6=fd7a:115c:a1e0::/48

# Ruta de persistencia de datos (SQLite y archivos)
DATA_DIR=./data

# Nivel de log: trace, debug, info, warn, error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# PANEL MI VPN (/mi-vpn)
# -----------------------------------------------------------------------------
# Usuarios: ven y gestionan sus dispositivos. Administradores: todo
# (dispositivos, usuarios, rutas, tags, ACL, DNS y API keys).

# Firma las cookies de sesión (lo genera install.sh). NO compartir.
PORTAL_SESSION_SECRET=

# OIDC del panel: lo deriva install.sh de AUTH_PROVIDER (vacío = sin SSO).
#   authentik -> su propio cliente 'mi-vpn' en Authentik
#   external  -> el mismo cliente que Headscale (registra /mi-vpn/callback)
PORTAL_OIDC_ISSUER=
PORTAL_OIDC_CLIENT_ID=
PORTAL_OIDC_CLIENT_SECRET=

# ¿Acepta también la API key de Headscale para entrar como admin? Acceso de
# emergencia si el proveedor OIDC falla. Sin OIDC se fuerza a true.
PORTAL_API_KEY_LOGIN=false

# Administradores: miembros de estos grupos (Authentik) o dueños de estos
# emails (proveedor propio). Separados por comas.
PORTAL_ADMIN_GROUPS="vpn-admins,authentik Admins"
PORTAL_ADMIN_EMAILS=

# uid/gid con los que corre el panel (dueño de los ficheros del proyecto, para
# editar el DNS en headscale-config.yaml) y gid del socket de Docker (para
# validar y reiniciar Headscale). Los detecta install.sh.
PORTAL_UID=1000
PORTAL_GID=1000
DOCKER_GID=999

# -----------------------------------------------------------------------------
# AUTENTICACIÓN OIDC (OPCIONAL)
# -----------------------------------------------------------------------------

# Cómo inician sesión los usuarios:
#   none      -> sin OIDC: el panel sólo acepta la API key (admins);
#                dispositivos con pre-auth keys
#   authentik -> Authentik integrado en /authentik/: usuario/contraseña y,
#                opcionalmente, login con Google
#   external  -> un proveedor OIDC propio (Keycloak, Authelia, Google...)
AUTH_PROVIDER=none

# Profiles de Compose activos: 'authentik' con AUTH_PROVIDER=authentik,
# vacío en otro caso. Lo lee Compose directamente de este fichero.
COMPOSE_PROFILES=

# ¿Habilitar OIDC? (true/false). Lo deriva install.sh de AUTH_PROVIDER.
# Headscale no tiene usuarios con contraseña propios: sin OIDC, al panel se
# entra con la API key de Headscale.
ENABLE_OIDC=false

# Issuer URL del proveedor OIDC (ej: https://auth.example.com/realms/master)
OIDC_ISSUER_URL=

# Client ID de la aplicación registrada en el proveedor OIDC
OIDC_CLIENT_ID=

# Client Secret de la aplicación
OIDC_CLIENT_SECRET=

# Scopes OIDC a solicitar (separados por espacios)
OIDC_SCOPE=openid profile email

# Claim que contiene el email del usuario
OIDC_EMAIL_CLAIM=email

# Aislamiento de red por usuario (ACL autogroup:self): los dispositivos de cada
# usuario sólo alcanzan los suyos, admins incluidos. install.sh sólo la aplica
# si Headscale aún no tiene política; nunca sobrescribe una existente.
NETWORK_ISOLATION=true

# -----------------------------------------------------------------------------
# AUTHENTIK (sólo con AUTH_PROVIDER=authentik)
# -----------------------------------------------------------------------------
# Con Authentik, install.sh rellena OIDC_ISSUER_URL, OIDC_CLIENT_ID=headscale y
# genera OIDC_CLIENT_SECRET; el blueprint authentik/blueprints/headscale.yaml
# crea el proveedor con esos mismos valores.

# Secretos generados por install.sh. NO cambiar tras el primer arranque.
AUTHENTIK_SECRET_KEY=
AUTHENTIK_PG_PASS=

# Usuario akadmin: sólo se leen en el primer arranque de Authentik
AUTHENTIK_ADMIN_EMAIL=
AUTHENTIK_BOOTSTRAP_PASSWORD=

# Login con Google (vacío = deshabilitado). Redirect URI en Google Cloud:
#   https://<DOMAIN>/authentik/source/oauth/callback/google/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Con SSL_MODE=front: IP del proxy de delante en la LAN, para que Headscale
# alcance la URL pública sin depender de NAT loopback. Vacío = DNS.
FRONT_PROXY_IP=

# -----------------------------------------------------------------------------
# AVANZADO
# -----------------------------------------------------------------------------

# Zona horaria para logs y timestamps
TZ=UTC

# Nombre de la red Docker interna
NETWORK_NAME=headscale-net

# Tag de la imagen de Headscale
HEADSCALE_IMAGE_TAG=latest

# Imagen de Python para el panel (sólo biblioteca estándar)
PORTAL_PYTHON_TAG=3.13-alpine

# Tag de la imagen de Caddy
CADDY_IMAGE_TAG=2-alpine

# Tag de la imagen de Authentik. Fijado a propósito (no 'latest'): Authentik
# migra la base de datos al actualizar y sólo admite saltos entre versiones
# consecutivas.
AUTHENTIK_IMAGE_TAG=2026.8.3
