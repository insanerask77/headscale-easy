# =============================================================================
# ${DOMAIN} — Headscale Easy
# =============================================================================
# Generated by install.sh. This is Traefik DYNAMIC configuration: copy it to
# the directory your file provider watches (e.g. /etc/traefik/dynamic/) and
# Traefik reloads it without a restart.
#
# No file provider yet? In the static configuration:
#
#   providers:
#     file:
#       directory: /etc/traefik/dynamic
#       watch: true
#
# Behind it a Caddy already routes by path (/ -> Headscale, /admin -> web UI),
# so there is ONE service: the whole domain is forwarded.
#
# Adjust 'entryPoints' and 'certResolver' to your own names.
#
# DERP: Headscale listens for STUN on UDP ${HEADSCALE_DERP_PORT} and that does
# NOT go through an HTTP router. Open that port straight to ${BACKEND_HOST}, or
# disable derp.server.enabled and use Tailscale's public relays.

http:
  routers:
    headscale:
      rule: "Host(`${DOMAIN}`)"
      entryPoints:
        - websecure
      service: headscale
      middlewares:
        - headscale-headers
      tls:
        certResolver: letsencrypt

    # HTTP -> HTTPS
    headscale-http:
      rule: "Host(`${DOMAIN}`)"
      entryPoints:
        - web
      service: headscale
      middlewares:
        - headscale-redirect

  middlewares:
    headscale-redirect:
      redirectScheme:
        scheme: https
        permanent: true

    headscale-headers:
      headers:
        # Traefik already sends X-Forwarded-* and handles the /ts2021 Upgrade
        stsSeconds: 31536000
        stsIncludeSubdomains: true
        contentTypeNosniff: true
        referrerPolicy: "strict-origin-when-cross-origin"

  services:
    headscale:
      loadBalancer:
        servers:
          - url: "http://${BACKEND_HOST}:${HTTP_PORT}"
        # /machine/map is a long-poll: no response buffering
        responseForwarding:
          flushInterval: "-1"
        passHostHeader: true

# The default serversTransport sets no response timeout, so the long-poll is
# not cut. If you use one with a low responseHeaderTimeout or idleConnTimeout,
# raise it or do not apply it to this service.
