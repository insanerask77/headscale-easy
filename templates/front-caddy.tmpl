# =============================================================================
# ${DOMAIN} — Headscale Easy
# =============================================================================
# Generated by install.sh. Add this block to your edge proxy's Caddyfile and
# reload it:
#
#   caddy validate --config /etc/caddy/Caddyfile
#   systemctl reload caddy
#
# Behind it another Caddy already routes by path (/ -> Headscale, /admin ->
# web UI), so forwarding the whole domain is enough.
#
# DERP: Headscale listens for STUN on UDP ${HEADSCALE_DERP_PORT} and that does
# NOT go through an HTTP reverse proxy. Open that port straight to
# ${BACKEND_HOST}, or disable derp.server.enabled and use Tailscale's relays.

${DOMAIN} {
    # Automatic HTTPS with Let's Encrypt: Caddy does it by itself for a
    # domain name. Uncomment one of these only if you want something else:
    #   tls you@example.com                renewal notices from Let's Encrypt
    #   tls /path/cert.pem /path/key.pem   your own certificate
    #   tls internal                       Caddy's internal CA

    log {
        output file /var/log/caddy/${DOMAIN}.access.log
        format json
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    reverse_proxy ${BACKEND_HOST}:${HTTP_PORT} {
        header_up X-Real-IP {remote_host}
        # /machine/map is a long-poll that stays open: stream it right away
        flush_interval -1
    }
}
