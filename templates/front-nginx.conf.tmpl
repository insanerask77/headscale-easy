# =============================================================================
# ${DOMAIN} - Headscale + Mi VPN
# =============================================================================
# Generado por install.sh. Cópialo a la máquina del proxy, normalmente en
# /etc/nginx/conf.d/${DOMAIN}.conf, y recarga con:
#
#   nginx -t && systemctl reload nginx
#
# Detrás hay un Caddy que ya enruta por ruta (/ -> Headscale, /mi-vpn ->
# panel), así que aquí sólo hace falta UN upstream: se reenvía el dominio
# entero y Caddy reparte.
#
# OJO con el relay DERP: Headscale escucha STUN en UDP ${HEADSCALE_DERP_PORT} y
# eso NO pasa por nginx. Abre ese puerto directo contra ${BACKEND_HOST} o
# desactiva derp.server.enabled y usa los relays públicos de Tailscale.

upstream headscale_stack {
    server ${BACKEND_HOST}:${HTTP_PORT};
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # El reto HTTP-01 de certbot, si lo usas
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    # -- TLS --------------------------------------------------------------
    # Ajusta las rutas a tus certificados (certbot, acme.sh, los que uses).
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Los clientes Tailscale suben mapas de red grandes; sin esto nginx corta
    # con 413.
    client_max_body_size 0;

    access_log /var/log/nginx/${DOMAIN}.access.log;
    error_log  /var/log/nginx/${DOMAIN}.error.log;

    location / {
        proxy_pass http://headscale_stack;

        # -- WebSocket / HTTP-upgrade -------------------------------------
        # /ts2021 (el protocolo de control actual) viaja sobre una conexión
        # "upgraded". HTTP/2 prohíbe las cabeceras Upgrade y Connection, así
        # que el salto hacia el backend TIENE que ser HTTP/1.1.
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        # -- Long-polling --------------------------------------------------
        # /machine/map deja la conexión abierta indefinidamente para empujar
        # cambios de la red. Con el proxy_read_timeout por defecto (60 s) los
        # nodos se reconectarían cada minuto; con buffering activado, los
        # cambios llegarían tarde.
        proxy_buffering    off;
        proxy_request_buffering off;
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
    }
}

# 'Connection' debe ir vacía en las peticiones normales y "upgrade" sólo cuando
# el cliente lo pide. Este map va a nivel http{}: si ya lo tienes definido en
# nginx.conf, borra estas líneas (nginx no admite duplicados).
#
#   map $http_upgrade $connection_upgrade {
#       default upgrade;
#       ''      close;
#   }
