# Headscale configuration — generated by Headscale Easy's install.sh
# https://github.com/insanerask77/headscale-easy
# Re-run ./install.sh to change it; manual edits are overwritten, except the
# dns: block, which the web UI manages and the installer keeps.
# Reference: https://github.com/juanfont/headscale/blob/main/config-example.yaml

---
# URL clients use to reach this server
server_url: ${SERVER_URL}

listen_addr: 0.0.0.0:${HEADSCALE_HTTP_PORT}
metrics_listen_addr: 0.0.0.0:${HEADSCALE_METRICS_PORT}
grpc_listen_addr: 0.0.0.0:${HEADSCALE_GRPC_PORT}
grpc_allow_insecure: false

# Address ranges handed out to devices
prefixes:
  v4: ${IP_PREFIXES_V4}
  v6: ${IP_PREFIXES_V6}
  allocation: sequential

# DERP relays: the one embedded in Headscale, plus Tailscale's public ones
# unless the installer was told to be fully self-hosted (DERP_USE_PUBLIC=false)
derp:
  ${DERP_URLS_CONFIG}
  server:
    enabled: true
    region_id: 999
    region_code: "custom"
    region_name: "Custom Embedded DERP"
    stun_listen_addr: "0.0.0.0:${HEADSCALE_DERP_PORT}"
    private_key_path: /var/lib/headscale/derp_server_private.key
    automatically_add_embedded_derp_region: true
  auto_update_enabled: ${DERP_AUTO_UPDATE}
  update_frequency: 24h
${DERP_PATHS_CONFIG}

private_key_path: /var/lib/headscale/private.key
noise:
  private_key_path: /var/lib/headscale/noise_private.key

database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite
    write_ahead_log: true

# ACL policy. "database" stores it in the database so the web UI can edit it
# (Access controls → Policy editor). With "file" and an empty path the API
# refuses policy changes.
policy:
  mode: database
  path: ""

# DNS: managed by the web UI (DNS page). install.sh writes the marked block
# and keeps the existing one when it regenerates this file.
${DNS_CONFIG}

log:
  format: text
  level: ${LOG_LEVEL}

# Proxies whose X-Forwarded-For is trusted, so logs show real client IPs
${TRUSTED_PROXIES_CONFIG}

# Local CLI socket (docker exec headscale headscale ...)
unix_socket: /var/run/headscale/headscale.sock
unix_socket_permission: "0770"

${OIDC_CONFIG}

node:
  # Key expiry of new devices (like Tailscale's "Key expiry", 180 days by
  # default); "0" = never. Admins change it in the web UI (Settings → General).
${KEY_EXPIRY_CONFIG}
  ephemeral:
    inactivity_timeout: 30m
  update_check_interval: 10s

cli:
  timeout: 5s
  insecure: false
