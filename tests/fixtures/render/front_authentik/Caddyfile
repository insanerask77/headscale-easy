# Caddyfile for Headscale Easy — https://github.com/insanerask77/headscale-easy
# Generated by install.sh: DO NOT EDIT, it is rewritten on every run.

:80 {
    # No TLS here: Caddy only routes over HTTP

    log {
        output file /var/log/caddy/access.log
        format json
    }

    header {
        # HSTS: sent by the front proxy
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # For external monitoring
    handle /healthz {
        respond "OK" 200
    }

    # Authentik (identity provider) under /authentik/ (AUTHENTIK_WEB__PATH):
    # the prefix is not stripped. /authentik alone redirects so it does not
    # fall into Headscale's catch-all.
    redir /authentik /authentik/ 308
    # Shortcut to the add-user form
    redir /add-user /authentik/if/flow/headscale-easy-add-user/ 302
    handle /authentik/* {
        reverse_proxy authentik-server:9000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto https
        }
    }

    # /register/<id>: Headscale sends the device to the OIDC provider

    # Headscale Easy web UI at /admin (the same path as Tailscale's console)
    handle /admin* {
        reverse_proxy headscale-easy:8000 {
            header_up X-Real-IP {remote_host}
        }
    }

    # Everything else belongs to Headscale. Tailscale clients use the domain
    # root (/key, /ts2021, /machine/*, /derp, /bootstrap-dns, /windows,
    # /apple, /oidc/*, /api/*...), so the control plane must be the default
    # destination.
    handle {
        reverse_proxy headscale:8080 {
            # Caddy already sends X-Forwarded-{For,Proto,Host}
            header_up X-Real-IP {remote_host}
        }
    }
}

# HTTP -> HTTPS redirect (only when Caddy holds the certificate)

