# Caddyfile for Headscale Easy — https://github.com/insanerask77/headscale-easy
# Generated by the all-in-one image: DO NOT EDIT, it is rewritten on every start.

192.168.1.10 {
    tls internal

    log {
        output file /data/caddy/logs/access.log
        format json
    }

    header {
        # HSTS disabled (self-signed certificate)
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # For external monitoring
    handle /healthz {
        respond "OK" 200
    }

    # Authentik is not part of the all-in-one image (HSE_AUTHENTIK_UPSTREAM routes /authentik to one)

    # Device sign-in without OIDC: approve it in the web UI
    @register path_regexp register ^/register/([A-Za-z0-9_:-]+)$
    redir @register /console/register/{re.register.1} 302

    # Headscale Easy web UI at /console (the same path as Tailscale's console)
    handle /console* {
        reverse_proxy 127.0.0.1:8000 {
            header_up X-Real-IP {remote_host}
        }
    }

    # Everything else belongs to Headscale. Tailscale clients use the domain
    # root (/key, /ts2021, /machine/*, /derp, /bootstrap-dns, /windows,
    # /apple, /oidc/*, /api/*...), so the control plane must be the default
    # destination.
    handle {
        reverse_proxy 127.0.0.1:8080 {
            # Caddy already sends X-Forwarded-{For,Proto,Host}
            header_up X-Real-IP {remote_host}
        }
    }
}

# HTTP -> HTTPS redirect (only when Caddy holds the certificate)
http://192.168.1.10 {
    redir https://{host}{uri} permanent
}
