# Headscale Easy + Authentik. Copy to .env (mode 600) and fill in the secrets.
# Generate each secret with:   openssl rand -base64 36 | tr -d '/+=' | cut -c1-40

# --- The address ---------------------------------------------------------------------------------
# https:// with HSE_TLS=auto gets a Let's Encrypt certificate (DNS must point here, ports 80/443
# reachable). Authentik is served at <this address>/authentik/.
HSE_PUBLIC_URL=https://vpn.example.com
# The host name of that address, alone: the image has to resolve it to itself (see HSE_SELF_IP)
HSE_DOMAIN=vpn.example.com
HSE_TLS=auto
ACME_EMAIL=admin@example.com

# Behind a proxy (HSE_TLS=off, see ../front-proxy): the proxy's address, and the same address in
# HSE_SELF_IP so the image reaches its own public name through the proxy. Otherwise leave both.
#HSE_TRUSTED_PROXIES=192.168.1.50/32
#HSE_SELF_IP=192.168.1.50

# --- Secrets (all of them required) --------------------------------------------------------------
AUTHENTIK_SECRET_KEY=
AUTHENTIK_PG_PASS=
# The OIDC client Headscale and the console sign in with. The id can stay as it is.
OIDC_CLIENT_ID=headscale
OIDC_CLIENT_SECRET=

# --- Authentik's first administrator ('akadmin'), read only on the first start --------------------
AUTHENTIK_ADMIN_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_PASSWORD=

# --- The console's administrator -------------------------------------------------------------------
# Who is an administrator of the console: members of the Authentik group 'vpn-admins' (add more
# groups with PORTAL_ADMIN_GROUPS), and these e-mail addresses.
PORTAL_ADMIN_EMAILS=
# Leave both empty to create a local administrator in the setup wizard instead.
HSE_ADMIN_EMAIL=
HSE_ADMIN_PASSWORD=

# --- Optional ----------------------------------------------------------------------------------------
TZ=UTC
#HSE_VERSION=latest
#HSE_HTTP_PORT=80
#HSE_HTTPS_PORT=443
#AUTHENTIK_IMAGE_TAG=2026.8.3
# "Sign in with Google" (see ../google.md for the OAuth client)
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
# Outgoing email, for Authentik's own messages
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_USE_TLS=false
#SMTP_FROM=authentik@example.com
