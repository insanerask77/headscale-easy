# Headscale Easy + Pocket ID. Copy to .env (mode 600).
# Generate secrets with:   openssl rand -base64 32

# Two DNS names pointing at this host
HSE_DOMAIN=vpn.example.com
ID_DOMAIN=id.example.com
ACME_EMAIL=admin@example.com

# Pocket ID encrypts what it stores with this key. Keep it: without it the data cannot be read.
POCKET_ID_ENCRYPTION_KEY=

# --- Fill these in AFTER creating the OIDC client in Pocket ID (README, step 2) -------------------------
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Who administers the console: these e-mail addresses (Pocket ID must send them as verified: README).
PORTAL_ADMIN_EMAILS=admin@example.com
# Leave both empty to also create a local administrator in the setup wizard.
HSE_ADMIN_EMAIL=
HSE_ADMIN_PASSWORD=

TZ=UTC
#HSE_VERSION=latest
#POCKET_ID_IMAGE_TAG=v1
