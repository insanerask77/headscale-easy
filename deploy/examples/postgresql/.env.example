# Headscale Easy with PostgreSQL. Copy to .env (mode 600) and edit.

HSE_PUBLIC_URL=https://vpn.example.com
HSE_TLS=auto
ACME_EMAIL=admin@example.com
HSE_ADMIN_EMAIL=
HSE_ADMIN_PASSWORD=
TZ=UTC

# The owner of the Headscale database. Headscale creates its tables and writes as this role; the same
# password starts the PostgreSQL container. Make it long and random (openssl rand -hex 24).
HEADSCALE_PG_PASS=

# The console reads the database (the devices' reported OS, version and relay) with this role instead.
# The image creates it on every start (idempotent) with permission to SELECT three columns of one table.
HEADSCALE_PG_RO_USER=headscale_ro
HEADSCALE_PG_RO_PASS=

#POSTGRES_VERSION=17
#HSE_VERSION=latest
