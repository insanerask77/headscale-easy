# Headscale Easy — all-in-one, advanced edition. Copy to .env (mode 600) and edit.
# Every variable the image reads is in docs/all-in-one.md; these are the ones an install needs.

# The address people and devices use to reach this server. https:// with HSE_TLS=auto gets a
# Let's Encrypt certificate (DNS must point here, ports 80 and 443 reachable from the Internet).
HSE_PUBLIC_URL=https://vpn.example.com

# auto     Let's Encrypt (needs ACME_EMAIL)
# internal a certificate of Caddy's own CA, for a LAN (install the CA on every client)
# off      this image speaks plain HTTP: use it behind a proxy you already run (see
#          ../examples/front-proxy) or with an http:// URL for a trusted network
HSE_TLS=auto
ACME_EMAIL=admin@example.com

# Leave HSE_ADMIN_EMAIL empty to create the administrator in the setup wizard (the one-time token
# is in `docker compose logs`). Set both to skip the wizard and start with that account.
HSE_ADMIN_EMAIL=
HSE_ADMIN_PASSWORD=

TZ=UTC

# --- Optional -----------------------------------------------------------------------------------
# Image tag (default: latest). Pin it in production: HSE_VERSION=2.0.0
#HSE_VERSION=latest

# Host ports. Change them behind a proxy (HSE_HTTP_PORT=8080) or when 80/443 are taken; keep the
# port in HSE_PUBLIC_URL in step.
#HSE_HTTP_PORT=80
#HSE_HTTPS_PORT=443

# A proxy in front: the CIDRs it connects from (never a whole network you do not control).
#HSE_TRUSTED_PROXIES=172.18.0.5/32

# Scheduled backups: nightly at 03:00, 14 days kept. "off" disables them.
#BACKUP_SCHEDULE=0 3 * * *
#BACKUP_KEEP_DAYS=14

# Upload backups elsewhere: docker compose --profile backup-remote up -d
#   an rclone remote  BACKUP_REMOTE=s3:my-bucket/headscale-easy   (config in ./remote-config/rclone.conf)
#   rsync over SSH    BACKUP_REMOTE=rsync:user@host:/srv/backups  (key in ./remote-config/id_ed25519)
#BACKUP_REMOTE=
#BACKUP_REMOTE_KEEP_DAYS=14
#BACKUP_AWS_ACCESS_KEY_ID=
#BACKUP_AWS_SECRET_ACCESS_KEY=

# External identity provider (see ../examples): the console and Headscale sign people in through it.
#OIDC_ISSUER=
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=

# External PostgreSQL instead of SQLite (see ../examples/postgresql).
#HEADSCALE_DB_TYPE=postgres
#HEADSCALE_PG_HOST=
#HEADSCALE_PG_NAME=headscale
#HEADSCALE_PG_USER=headscale
#HEADSCALE_PG_PASS=
#HEADSCALE_PG_RO_USER=headscale_ro
#HEADSCALE_PG_RO_PASS=
